AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR: only set to true once `php artisan inertia:start-ssr` is running on the host
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714
# Full path to node if PHP can't find it (cPanel), used by /admin/ssr/start
NODE_BINARY=node

# Canonical host used for canonical / og:url / sitemap URLs
SEO_BASE_URL=

